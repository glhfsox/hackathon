# Variable names only. Copy to .env and fill in. Never commit real values.

# API keys of the policy callers. policy.yaml refers to them by name (api_key_env).
DEMO_API_KEY=
SUPPORT_API_KEY=
PLAYGROUND_API_KEY=
ORCHESTRATOR_API_KEY=
# test_app agents (Analyst, and the Operator per user role).
ANALYST_API_KEY=
OPERATOR_CLERK_API_KEY=
OPERATOR_TREASURER_API_KEY=

# Jev, the remote AI decision maker (TypeSafe System One). Empty means: use the local fallback.
TYPESAFE_API_KEY=

# Optional Langfuse tracing (self-hosted or cloud). Empty means: disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
