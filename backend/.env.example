# Variable names only. Copy to .env and fill in. Never commit real values.

# Shared secret the agent signs its JWT with (HS256). Required: the layer refuses to start without it.
JWT_SECRET=

# OpenAI: the demo model (gpt-4o-mini) and Jev's fallback (policy.yaml api_key_env).
OPENAI_API_KEY=

# Jev, the remote AI decision maker (TypeSafe System One). Empty means: use the fallback.
TYPESAFE_API_KEY=

# Optional Langfuse tracing (self-hosted or cloud). Empty means: disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
