# Variable names only. Never commit real values.
# `docker compose run --rm init` copies this file to .env and fills JWT_SECRET with a random value.

# Shared secret of the signed JWTs (HS256): the layer verifies with it, the demo agents and
# test_app sign their own tokens with it. Required: the layer refuses to start without it.
JWT_SECRET=

# OpenAI: the demo model (gpt-4o-mini) and Jev's fallback. Empty means: those requests fail
# closed (`upstream_unavailable`, or a Jev block when Jev is down too).
OPENAI_API_KEY=

# Jev, the remote AI decision maker. Empty means: use the fallback (OpenAI).
TYPESAFE_API_KEY=

# Optional Langfuse tracing. Empty means: disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
