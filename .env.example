# Variable names only. Never commit real values.
# `docker compose run --rm init` copies this file to .env and fills every *_API_KEY below,
# except TYPESAFE_API_KEY, with a random value.

# Policy callers (backend/policy.yaml refers to them by name).
DEMO_API_KEY=
SUPPORT_API_KEY=
PLAYGROUND_API_KEY=
ORCHESTRATOR_API_KEY=
# test_app agents: the Analyst, and the Operator per user role.
ANALYST_API_KEY=
OPERATOR_CLERK_API_KEY=
OPERATOR_TREASURER_API_KEY=

# Jev, the remote AI decision maker. Empty means: use the local Ollama fallback.
TYPESAFE_API_KEY=

# Optional Langfuse tracing. Empty means: disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
